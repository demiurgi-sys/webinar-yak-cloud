# ===== Node.js API =====
PORT=4000
NODE_ENV=production

# PostgreSQL (при docker-compose host = "db", ім'я сервісу)
DATABASE_URL=postgresql://webinar_user:CHANGE_ME@db:5432/webinar_leads
PGPOOL_MAX=10
# PGSSLMODE=require   # розкоментувати, якщо БД потребує SSL

# CORS — список дозволених Origin через кому; "*" = дозволити всіх (не для продакшну!)
ALLOWED_ORIGINS=https://webinar.school-design.space,https://demiurgi-sys.github.io

# ===== Facebook Conversions API =====
FB_PIXEL_ID=
FB_ACCESS_TOKEN=
# FB_TEST_EVENT_CODE=TEST12345   # для тестування у Events Manager

# ===== SmartSender / Telegram =====
TELEGRAM_BOT=GrinevichSchooldesign2023_bot
# мітка входу ефіру web_reg_<ддммрр>
SMARTSENDER_START_CONTEXT=web_reg_291026
